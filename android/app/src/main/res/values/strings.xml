    <!-- Guide -->
    <string name="guide_title_first">First time? Set up in three steps</string>
    <string name="guide_title">How to set up</string>
    <string name="guide_collapsed">What to install on your Mac, and how to connect</string>
    <string name="guide_step1_title">Install Annex on your Mac</string>
    <string name="guide_step1_body">Open this page on your Mac and download the Mac app. Share or copy the link to send it over.</string>
    <string name="guide_share">Share link</string>
    <string name="guide_copy">Copy</string>
    <string name="share_subject">Annex for Mac</string>
    <string name="share_text">Download Annex for Mac: %1$s</string>
    <string name="guide_step2_title">Allow access on the Mac</string>
    <string name="guide_step2_body">The first time it opens, Annex walks you through allowing Screen Recording and Accessibility. It then waits in the menu bar.</string>
    <string name="guide_step3_title">Connect</string>
    <string name="guide_wifi_title">Over Wi-Fi</string>
    <string name="guide_wifi_body">Join the same network as your Mac. Your Mac appears above automatically. The first time, approve this device on the Mac.</string>
    <string name="guide_usb_title">With a USB cable</string>
    <string name="guide_usb_body">Turn on USB debugging in Developer options, then plug in the cable. The Mac also needs Android platform tools — the Mac app shows you how.</string>
    <string name="guide_open_dev">Open Developer options</string>
    <string name="guide_dev_hint">Don\'t see Developer options? Go to Settings → About phone and tap Build number seven times.</string>
    <string name="dev_not_enabled">Tap “Build number” seven times to turn on Developer options</string>

